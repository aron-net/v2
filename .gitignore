# Test/cache files
.pytest_cache/

# IDE/editor files
.vscode/
.idea/

# Operating-system files
.DS_Store
# Google OAuth credentials and tokens
credentials.json
token.json
client_secret*.json

# Additional test and coverage output
.coverage
htmlcov/

